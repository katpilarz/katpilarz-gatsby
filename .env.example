# Copy to .env.development (and .env.production for `build`/`serve`), then
# fill in. Real values stay local: both files are gitignored.

# Sanity project the site pulls content from. Found at https://sanity.io/manage
GATSBY_SANITY_PROJECT_ID=
GATSBY_SANITY_DATASET=

# Optional. Only needed to preview unpublished drafts in `npm run develop`.
# Create one at https://sanity.io/manage under API > Tokens (Viewer role).
# SANITY_READ_TOKEN=
